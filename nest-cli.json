{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "apps/auth-service/src",
    "monorepo": true,
    "root": "apps/auth-service",
    "compilerOptions": {
      "tsConfigPath": "apps/auth-service/tsconfig.app.json"
    },
    "projects": {
      "auth-service": {
        "type": "application",  
        "root": "apps/auth-service",
        "entryFile": "main",
        "sourceRoot": "apps/auth-service/src",
        "compilerOptions": {
          "tsConfigPath": "apps/auth-service/tsconfig.app.json"
        }
      },
      "schedule-service": {
        "type": "application",
        "root": "apps/schedule-service",
        "entryFile": "main",
        "sourceRoot": "apps/schedule-service/src",
        "compilerOptions": {
          "tsConfigPath": "apps/schedule-service/tsconfig.app.json"
        }
      }
    }
  }

