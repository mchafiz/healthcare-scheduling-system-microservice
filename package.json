{
    "name": "healthcare-scheduling-system",
    "version": "1.0.0",
    "private": true,  
    "scripts": {
      "start:auth": "nest start auth-service",
      "start:schedule": "nest start schedule-service",
      "start:auth:dev": "nest start auth-service --watch",
      "start:schedule:dev": "nest start schedule-service --watch",
      "build:auth": "nest build auth-service",
      "build:schedule": "nest build schedule-service",
      "test": "jest",
      "test:watch": "jest --watch",
      "prisma:generate:auth": "prisma generate --schema=prisma/auth-service/schema.prisma",
      "prisma:generate:schedule": "prisma generate --schema=prisma/schedule-service/schema.prisma",
      "prisma:migrate:auth": "prisma migrate dev --schema=prisma/auth-service/schema.prisma",
      "prisma:migrate:schedule": "prisma migrate dev --schema=prisma/schedule-service/schema.prisma"
    },
    "dependencies": { 
      "@nestjs/common": "^10.0.0",
      "@nestjs/core": "^10.0.0",
      "@nestjs/graphql": "^12.0.0",
      "@nestjs/apollo": "^12.0.0",
      "@nestjs/microservices": "^10.0.0",
      "@nestjs/jwt": "^10.0.0",
      "@nestjs/platform-express": "^10.0.0",
      "@apollo/server": "^4.0.0",
      "@prisma/client": "^5.0.0",
      "bcrypt": "^5.1.0",
      "graphql": "^16.0.0",
      "reflect-metadata": "^0.1.13",
      "rxjs": "^7.8.0"
    },
    "devDependencies": { 
      "@nestjs/cli": "^10.0.0",
      "@nestjs/testing": "^10.0.0",
      "@types/bcrypt": "^5.0.0",
      "@types/jest": "^29.0.0", 
      "@types/node": "^20.0.0",
      "jest": "^29.0.0",
      "prisma": "^5.0.0",
      "ts-jest": "^29.0.0",
      "typescript": "^5.0.0"
    },
    "jest": {
      "moduleFileExtensions": ["js", "json", "ts"],
      "rootDir": ".",
      "testRegex": ".*\\.spec\\.ts$",
      "transform": { "^.+\\.(t|j)s$": "ts-jest" },
      "collectCoverageFrom": ["**/*.(t|j)s"],
      "coverageDirectory": "./coverage",
      "testEnvironment": "node",
      "roots": ["<rootDir>/apps/"]
    }
  }

