generator client {  
    provider = "prisma-client-js"
    output   = "../../node_modules/@prisma/auth-client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL_AUTH")
}


model User {
    id        String   @id @default(uuid())
    email     String   @unique
    password  String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
  
    @@map("users")
}


